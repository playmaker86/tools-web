# Base URL used for canonical URLs, sitemap, and robots.txt
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google AdSense — the script always loads for site verification (as long as CLIENT_ID is set).
# ENABLED only controls whether ad slots are rendered on the page.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_TOP=1234567890
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=1234567890
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM_LEFT=1234567890
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM_RIGHT=1234567890
